generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model tenants {
  id         String   @id @default(uuid())
  name       String
  slug       String   @unique
  settings   Json     @default("{}")
  branding   Json     @default("{}")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  profiles profiles[]
  trips    trips[]
}

model profiles {
  id            String   @id @default(uuid())
  tenant_id     String?
  full_name     String?
  email         String   @unique
  password      String
  auth_provider String   @default("credentials")
  role          String   @default("jemaah")
  metadata      Json     @default("{}")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  tenant tenants? @relation(fields: [tenant_id], references: [id])
  trips  trips[]

  @@index([tenant_id])
  @@index([role])
}

model trips {
  id             String   @id @default(uuid())
  user_id        String
  tenant_id      String
  name           String
  type           String
  start_date     DateTime
  end_date       DateTime
  total_emission Decimal  @default(0) @db.Decimal(10, 2)
  status         String   @default("ongoing")
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  profile  profiles      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  tenant   tenants       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  journeys journey_data?

  @@index([user_id])
  @@index([tenant_id])
}

model journey_data {
  id             String   @id @default(uuid())
  trip_id        String   @unique
  phases         Json     @default("{}")
  total_emission Decimal  @default(0) @db.Decimal(10, 2)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  trip trips @relation(fields: [trip_id], references: [id], onDelete: Cascade)
}

model hajj_periods {
  id                       Int      @id @default(autoincrement())
  year                     Int      @unique
  start_date               DateTime
  end_date                 DateTime
  registration_open_date   DateTime
  registration_close_date  DateTime
  is_active                Boolean  @default(true)
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt

  @@index([year])
  @@index([is_active])
}
