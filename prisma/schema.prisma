generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model tenants {
  id         String   @id @default(uuid())
  name       String
  slug       String   @unique
  settings   Json     @default("{}")
  branding   Json     @default("{}")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  profiles                    profiles[]
  trips                       trips[]
  csr_activities              csr_activities[]
  payment_config              TenantPaymentConfig?
  hotels                      hotels[]
  // carbon_payment_config is now global, not per-tenant
}

model profiles {
  id            String   @id @default(uuid())
  tenant_id     String?
  full_name     String?
  email         String   @unique
  password      String
  auth_provider String   @default("credentials")
  role          String   @default("jemaah")
  metadata      Json     @default("{}")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  tenant                          tenants? @relation(fields: [tenant_id], references: [id])
  trips                           trips[]
  csr_activity_participations     csr_activity_participations[]
  carbon_certificate_purchases    carbon_certificate_purchases[]

  @@index([tenant_id])
  @@index([role])
}

model trips {
  id             String   @id @default(uuid())
  user_id        String
  tenant_id      String
  name           String
  type           String
  start_date     DateTime
  end_date       DateTime
  total_emission Decimal  @default(0) @db.Decimal(10, 2)
  status         String   @default("ongoing")
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  profile  profiles      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  tenant   tenants       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  journeys journey_data?

  @@index([user_id])
  @@index([tenant_id])
}

model journey_data {
  id             String   @id @default(uuid())
  trip_id        String   @unique
  phases         Json     @default("{}")
  total_emission Decimal  @default(0) @db.Decimal(10, 2)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  trip trips @relation(fields: [trip_id], references: [id], onDelete: Cascade)
}

model hajj_periods {
  id                       Int      @id @default(autoincrement())
  year                     Int      @unique
  start_date               DateTime
  end_date                 DateTime
  registration_open_date   DateTime
  registration_close_date  DateTime
  is_active                Boolean  @default(true)
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt

  @@index([year])
  @@index([is_active])
}

model airports {
  id         Int      @id @default(autoincrement())
  name       String
  icao       String?
  iata       String?
  country    String
  lat        Float
  lon        Float
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([country])
  @@index([is_active])
  @@index([iata])
  @@index([icao])
}

model seaports {
  id          Int      @id @default(autoincrement())
  source_id   Int?     @unique
  name        String
  alias_name  String?
  latitude    Float
  longitude   Float
  province    String?
  city        String?
  address     String?
  country_id  Int?
  country_code String  @default("ID")
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([country_code])
  @@index([is_active])
  @@index([name])
}

model hotels {
  id                Int      @id @default(autoincrement())
  name              String
  address           String
  tenant_id         String?
  hotel_emission_id Int?
  country           String
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  tenant          tenants?         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  hotel_emission  hotel_emission?  @relation(fields: [hotel_emission_id], references: [id], onDelete: SetNull)

  @@index([tenant_id])
  @@index([hotel_emission_id])
  @@index([country])
  @@index([name])
}

model hotel_emission {
  id               Int      @id @default(autoincrement())
  country          String
  emission_factor  Decimal  @db.Decimal(10, 4)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  hotels hotels[]

  @@index([country])
}

model jenis_kendaraan {
  id                   Int      @id @default(autoincrement())
  name                 String
  emission_factor      Decimal? @db.Decimal(12, 6)
  type                 String
  emission_factor_name String
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  @@unique([name, type])
  @@index([type])
  @@index([name])
}

model faktor_emisi_makanan {
  id                   Int      @id @default(autoincrement())
  name                 String   @unique
  emission_factor      Decimal  @db.Decimal(10, 4)
  emission_factor_name String
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  @@index([name])
}

model faktor_emisi_limbah {
  id                   Int      @id @default(autoincrement())
  name                 String   @unique
  emission_factor      Decimal  @db.Decimal(12, 5)
  emission_factor_name String
  source               String?
  unit                 String
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  @@index([name])
}

model sessions {
  id            String   @id
  user_id       String?  @db.Uuid
  ip_address    String?  @db.VarChar(45)
  user_agent    String?  @db.Text
  payload       String   @db.Text
  last_activity Int

  @@index([user_id])
  @@index([last_activity])
}

model csr_activities {
  id                    String   @id @default(uuid())
  tenant_id             String
  title                 String
  description           String
  category              String
  location              String
  status                String   @default("upcoming")
  start_date              DateTime
  end_date                DateTime
  activity_date           DateTime
  total_donations_amount  Decimal  @default(0) @db.Decimal(14, 2)
  target_donation_amount  Decimal  @db.Decimal(14, 2)
  image_url               String?
  contact_person          String
  contact_phone           String
  contact_email           String
  incentives              Json     @default("{}")
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  tenant            tenants @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  participations    csr_activity_participations[]

  @@index([tenant_id])
  @@index([status])
  @@index([category])
}

model csr_activity_participations {
  id                           String   @id @default(uuid())
  user_id                      String
  csr_activity_id              String
  type                         String   @default("donate")
  amount                       Decimal? @db.Decimal(12, 2)
  status                       String   @default("pending")
  payment_method               String?
  transaction_reference        String?
  thank_you_certificate_url    String?
  participation_certificate_url String?
  notes                        String?
  created_at                   DateTime @default(now())
  updated_at                   DateTime @updatedAt

  user        profiles       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  csr_activity csr_activities @relation(fields: [csr_activity_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([csr_activity_id])
  @@index([status])
  @@unique([user_id, csr_activity_id])
}

model carbon_certificate_purchases {
  id                              String   @id @default(uuid())
  user_id                         String
  product_id                      String?
  certificate_provider            String   @default("IDX_CARBON")
  co2_equivalent                  Decimal  @db.Decimal(12, 2)
  amount                          Decimal  @db.Decimal(12, 2)
  units                           Int?
  total_price                     Decimal  @db.Decimal(12, 2)
  transaction_reference           String?
  thank_you_certificate_url       String?
  emission_reduction_certificate_url String?
  batch_id                        String?
  certificate_id                  String?
  purchase_date                   DateTime @default(now())
  status                          String   @default("pending")
  payment_method                  String?
  notes                           String?
  metadata                        Json?
  created_at                      DateTime @default(now())
  updated_at                      DateTime @updatedAt

  user     profiles          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product  carbon_products?  @relation(fields: [product_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([status])
  @@index([certificate_provider])
}

model TenantPaymentConfig {
  id                    String   @id @default(cuid())
  tenant_id             String   @unique
  midtrans_server_key   String
  midtrans_client_key   String
  midtrans_merchant_id  String
  is_production         Boolean  @default(false)
  enabled               Boolean  @default(true)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  tenant tenants @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
}

model CarbonPaymentConfig {
  id                    String   @id @default(cuid())
  midtrans_server_key   String
  midtrans_client_key   String
  midtrans_merchant_id  String
  is_production         Boolean  @default(false)
  enabled               Boolean  @default(true)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt
}

model carbon_products {
  id            String   @id @default(cuid())
  product_code  String   @unique
  name          String
  description   String?
  price         Decimal  @db.Decimal(12, 2)
  project       String
  category      String?
  image_url     String?
  color_class   String?
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  purchases carbon_certificate_purchases[]

  @@index([is_active])
}
