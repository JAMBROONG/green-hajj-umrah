generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model tenants {
  id         String   @id @default(uuid())
  name       String
  slug       String   @unique
  settings   Json     @default("{}")
  branding   Json     @default("{}")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  profiles profiles[]
  trips    trips[]
}

model profiles {
  id            String   @id @default(uuid())
  tenant_id     String?
  full_name     String?
  email         String   @unique
  password      String
  auth_provider String   @default("credentials")
  role          String   @default("jemaah")
  metadata      Json     @default("{}")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  tenant tenants? @relation(fields: [tenant_id], references: [id])
  trips  trips[]

  @@index([tenant_id])
  @@index([role])
}

model trips {
  id             String   @id @default(uuid())
  user_id        String
  tenant_id      String
  name           String
  type           String
  start_date     DateTime
  end_date       DateTime
  total_emission Decimal  @default(0) @db.Decimal(10, 2)
  status         String   @default("ongoing")
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  profile  profiles      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  tenant   tenants       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  journeys journey_data?

  @@index([user_id])
  @@index([tenant_id])
}

model journey_data {
  id             String   @id @default(uuid())
  trip_id        String   @unique
  phases         Json     @default("{}")
  total_emission Decimal  @default(0) @db.Decimal(10, 2)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  trip trips @relation(fields: [trip_id], references: [id], onDelete: Cascade)
}

model hajj_periods {
  id                       Int      @id @default(autoincrement())
  year                     Int      @unique
  start_date               DateTime
  end_date                 DateTime
  registration_open_date   DateTime
  registration_close_date  DateTime
  is_active                Boolean  @default(true)
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt

  @@index([year])
  @@index([is_active])
}

model airports {
  id         Int      @id @default(autoincrement())
  name       String
  icao       String?
  iata       String?
  country    String
  lat        Float
  lon        Float
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([country])
  @@index([is_active])
  @@index([iata])
  @@index([icao])
}

model seaports {
  id          Int      @id @default(autoincrement())
  source_id   Int?     @unique
  name        String
  alias_name  String?
  latitude    Float
  longitude   Float
  province    String?
  city        String?
  address     String?
  country_id  Int?
  country_code String  @default("ID")
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([country_code])
  @@index([is_active])
  @@index([name])
}

model hotels {
  id                   Int      @id @default(autoincrement())
  name                 String
  factor_emission      Decimal  @db.Decimal(10, 4)
  factor_emission_name String
  address              String
  country_code         String
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  @@index([country_code])
  @@index([name])
}

model jenis_kendaraan {
  id                   Int      @id @default(autoincrement())
  name                 String
  emission_factor      Decimal? @db.Decimal(12, 6)
  type                 String
  emission_factor_name String
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  @@unique([name, type])
  @@index([type])
  @@index([name])
}

model faktor_emisi_makanan {
  id                   Int      @id @default(autoincrement())
  name                 String   @unique
  emission_factor      Decimal  @db.Decimal(10, 4)
  emission_factor_name String
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  @@index([name])
}

model faktor_emisi_limbah {
  id                   Int      @id @default(autoincrement())
  name                 String   @unique
  emission_factor      Decimal  @db.Decimal(12, 5)
  emission_factor_name String
  source               String?
  unit                 String
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  @@index([name])
}

model sessions {
  id            String   @id
  user_id       String?  @db.Uuid
  ip_address    String?  @db.VarChar(45)
  user_agent    String?  @db.Text
  payload       String   @db.LongText
  last_activity Int

  @@index([user_id])
  @@index([last_activity])
}
