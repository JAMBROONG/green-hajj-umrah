// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Tenant (Organization/Client)
model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  settings  Json     @default("{}")
  branding  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profiles  Profile[]
  trips     Trip[]

  @@map("tenants")
}

// User Profile
model Profile {
  id           String   @id @default(uuid())
  tenantId     String?  @map("tenant_id")
  fullName     String?  @map("full_name")
  email        String   @unique
  password     String
  authProvider String   @default("credentials") @map("auth_provider")
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant   Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  trips    Trip[]

  @@index([tenantId])
  @@map("profiles")
}

// Trip (Haji/Umrah Journey)
model Trip {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  tenantId      String   @map("tenant_id")
  name          String   // "Umrah Ramadan 2026"
  type          String   // "haji" or "umrah"
  startDate     DateTime @map("start_date")
  endDate       DateTime @map("end_date")
  totalEmission Decimal  @default(0) @map("total_emission") @db.Decimal(10, 2)
  status        String   @default("ongoing") // ongoing, completed, cancelled
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user     Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  journeys JourneyData[]

  @@index([userId])
  @@index([tenantId])
  @@map("trips")
}

// Journey Data (Phase data for each trip)
model JourneyData {
  id            String   @id @default(uuid())
  tripId        String   @map("trip_id")
  phases        Json     @default("{}")
  totalEmission Decimal  @default(0) @map("total_emission") @db.Decimal(10, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId])
  @@map("journey_data")
}
